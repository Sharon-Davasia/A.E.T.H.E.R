{
  "name": "@aether/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": { "node": "22.22.3", "npm": "10.9.8" },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/write-electron-package.js",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "npm run build:renderer && tsx --test tests/*.test.ts",
    "test:python": "python -m unittest discover -s tests -p \"test_*.py\" -v",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:python && npm run build:electron"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "autoprefixer": "10.4.22",
    "electron": "39.2.3",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "16.5.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.2.2"
  }
}
